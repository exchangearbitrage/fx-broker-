DATABASE_URL="file:./dev.db"
# A long, random server-only value used to sign the short-lived registration math check.
HUMAN_CHALLENGE_SECRET="replace-with-a-long-random-value"
MARKET_DATA_PROVIDER="coingecko"
# CoinGecko Demo key. Keep this secret; never add it to browser code.
CG_API_KEY=""
TWELVE_DATA_API_KEY=""
# Set to false to disable browser-based Google Website Translator.
NEXT_PUBLIC_AUTO_TRANSLATE="true"

# Administrator Credentials (used by prisma/seed.mjs)
ADMIN_EMAIL="admin@brokerage.local"
ADMIN_PASSWORD="DedicatedPassword123"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Or legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only (optional, for admin/storage operations):
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
