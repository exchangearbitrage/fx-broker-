{
  "name": "white-label-trading-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/select-brand.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/select-brand.mjs && node scripts/refresh-fx-snapshot.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:fx": "tsx scripts/test-fx-route.ts",
    "seed": "prisma db seed",
    "new-brand": "node scripts/new-brand.mjs",
    "check:brand-leaks": "node scripts/check-brand-leaks.mjs",
    "crawl": "node scripts/crawl-routes.mjs",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma generate --schema prisma/schema.postgres.prisma && prisma migrate deploy --schema prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "next": "15.5.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
